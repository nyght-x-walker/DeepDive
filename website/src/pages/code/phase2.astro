    </div>
    <div style="margin-top:14px;display:flex;gap:10px"><a class="btn ghost" href="/handouts/phase2">Handout</a><a class="btn ghost" href="/phase2_vulnerable_strcpy.cpp" download>Download raw .cpp</a><a class="btn" href="/#strcpy">Back to simulator</a></div>
