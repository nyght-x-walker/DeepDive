---
import Layout from '../../layouts/Layout.astro';
import code from '../../../public/phase1_boundary_model.cpp?raw';
---
<Layout title="Code, Phase 1 boundary">
  <div class="container" style="padding:40px 0;max-width:860px">
    <div class="eyebrow">Code • Phase 1</div>
    <h1 style="font-family:Fraunces,serif;font-size:30px;margin:8px 0">phase1_boundary_model.cpp</h1>
    <p style="color:var(--muted);font:14px Inter">One array of 20 bytes, capped with std::min. No real overflow.</p>
    <div class="card" style="margin-top:16px;background:#0f172a;border-color:#1e293b">
      <pre style="margin:0;font:13px 'JetBrains Mono';color:#e2e8f0;white-space:pre-wrap;word-break:break-word;overflow-x:auto">{code}</pre>
    </div>
    <div style="margin-top:14px;display:flex;gap:10px"><a class="btn ghost" href="/handouts/phase1">Handout</a><a class="btn ghost" href="/phase1_boundary_model.cpp" download>Download raw .cpp</a><a class="btn" href="/#boundary">Back to playground</a></div>
  </div>
</Layout>
