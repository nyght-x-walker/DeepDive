---
import Layout from '../../layouts/Layout.astro';
import code from '../../../public/initial_prototype.cpp?raw';
---
<Layout title="Code, Initial Prototype">
  <div class="container" style="padding:40px 0;max-width:860px">
    <div class="eyebrow">Code • Initial Prototype</div>
    <h1 style="font-family:Fraunces,serif;font-size:30px;margin:8px 0">initial_prototype.cpp</h1>
    <p style="color:var(--muted);font:14px Inter">Stack vs heap vs smart pointers. MyData id 42, 100, 200.</p>
    <div class="card" style="margin-top:16px;background:#0f172a;border-color:#1e293b">
      <pre style="margin:0;font:13px 'JetBrains Mono';color:#e2e8f0;white-space:pre-wrap;word-break:break-word;overflow-x:auto">{code}</pre>
    </div>
    <div style="margin-top:14px;display:flex;gap:10px"><a class="btn ghost" href="/DeepDive/handouts/initial">Handout</a><a class="btn ghost" href="/DeepDive/initial_prototype.cpp" download>Download raw .cpp</a><a class="btn" href="/DeepDive/#initial">Back to playground</a></div>
  </div>
</Layout>
