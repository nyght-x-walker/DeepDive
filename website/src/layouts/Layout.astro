---
interface Props { title?: string; }
const { title = "C++ Memory Safety Deep Dive" } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
<style is:global>
:root{
  --bg:#f8fafc; --bg2:#ffffff; --bg3:#f1f5f9; --border:#e2e8f0; --border2:#cbd5e1;
  --text:#0f172a; --muted:#475569; --faint:#64748b;
  --indigo:#4f46e5; --indigo2:#6366f1; --emerald:#059669; --amber:#d97706; --rose:#e11d48; --sky:#0284c7;
  --radius:16px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Inter,system-ui,sans-serif;background:var(--bg);color:var(--text);line-height:1.7;-webkit-font-smoothing:antialiased}
a{color:var(--indigo);text-decoration:none} a:hover{color:var(--indigo2)}
.mono{font-family:"JetBrains Mono",monospace}
.container{max-width:1120px;margin:0 auto;padding:0 24px}
.nav{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.82);backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
.nav-inner{height:64px;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:-.02em;font-size:15px}
.brand-mark{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,var(--indigo),#7c3aed);display:grid;place-items:center;color:white;font:700 13px "JetBrains Mono"}
.brand span{color:var(--indigo)}
.nav-links{display:flex;gap:6px}
.nav-links a{font:500 13px Inter;padding:7px 12px;border-radius:999px;color:var(--muted)}
.nav-links a:hover{background:var(--bg3);color:var(--text)}
.hero{padding:72px 0 32px;position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;background:radial-gradient(600px 300px at 20% -10%, rgba(79,70,229,.08), transparent 60%), radial-gradient(500px 300px at 90% 0%, rgba(14,165,233,.07), transparent 60%);pointer-events:none}
.hero h1{font-family:Fraunces,serif;font-size:52px;line-height:1.05;letter-spacing:-.03em;margin:0 0 16px;font-weight:700}
.hero h1 em{font-style:normal;background:linear-gradient(135deg,var(--indigo),#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero p{color:var(--muted);max-width:680px;font-size:18px;line-height:1.6;margin:0}
.hero-actions{margin-top:22px;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.badge{display:inline-flex;align-items:center;gap:6px;font:600 11px "JetBrains Mono";letter-spacing:.08em;text-transform:uppercase;padding:6px 10px;border-radius:999px;background:var(--bg3);border:1px solid var(--border);color:var(--faint)}
.badge.dot::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--emerald)}
.card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:20px;box-shadow:0 1px 2px rgba(15,23,42,.04), 0 4px 12px rgba(15,23,42,.04)}
.card.hover:hover{border-color:var(--border2);box-shadow:0 4px 16px rgba(15,23,42,.06);transition:all .2s}
.btn{display:inline-flex;align-items:center;gap:8px;background:var(--indigo);color:white;font:600 14px Inter;border:0;border-radius:999px;padding:12px 18px;box-shadow:0 1px 2px rgba(79,70,229,.2)}
.btn:hover{background:#4338ca;color:white}
.btn.ghost{background:var(--bg2);color:var(--text);border:1px solid var(--border);box-shadow:none}
.btn.ghost:hover{border-color:var(--border2);background:var(--bg3)}
.grid{display:grid;gap:16px}
@media(min-width:900px){.grid.cols2{grid-template-columns:1fr 1fr}.grid.cols3{grid-template-columns:1fr 1fr 1fr}}
.kbd{font:500 12px "JetBrains Mono";background:white;border:1px solid var(--border);padding:3px 7px;border-radius:6px;color:var(--faint);box-shadow:0 1px 2px rgba(0,0,0,.04)}
.progress{position:fixed;top:64px;left:0;height:2px;background:linear-gradient(90deg,var(--indigo),#7c3aed);z-index:30;transform-origin:left}
.chapter{padding:56px 0}
.chapter + .chapter{border-top:1px solid var(--border)}
.chapter h2{font-family:Fraunces,serif;font-size:30px;letter-spacing:-.02em;margin:0 0 6px}
.chapter h3{font:500 15px Inter;color:var(--faint);margin:0 0 22px;line-height:1.5}
.eyebrow{font:600 11px "JetBrains Mono";letter-spacing:.1em;text-transform:uppercase;color:var(--indigo);margin-bottom:8px}
.callout{border-left:3px solid var(--indigo);background:rgba(79,70,229,.06);padding:12px 14px;border-radius:0 10px 10px 0;font:14px Inter;color:var(--muted)}
.disclaimer{border:1px solid #fecdd3;background:#fff1f2;color:#881337;border-radius:12px;padding:14px 16px;font:13px Inter}
.toc{position:sticky;top:80px}
.prose{max-width:720px}
.prose h3{font:600 16px Inter;margin:18px 0 8px}
.prose p{color:var(--muted);font-size:15px;line-height:1.7;margin:8px 0}
</style>
<script>
addEventListener('scroll',()=>{
  const h=document.documentElement;
  const p=(h.scrollTop)/(h.scrollHeight-h.clientHeight);
  const bar=document.querySelector('.progress');
  if(bar) bar.style.transform=`scaleX(${p})`;
});
</script>
</head>
<body>
<div class="progress" style="transform:scaleX(0)"></div>
<nav class="nav"><div class="container nav-inner"><div class="brand"><div class="brand-mark">D</div><div><div style="line-height:1">DeepDive</div><div style="font:500 11px Inter;color:var(--faint);letter-spacing:.04em;margin-top:-2px">C++ MEMORY SAFETY</div></div></div><div class="nav-links"><a href="/DeepDive/#initial">Initial</a><a href="/DeepDive/#boundary">Boundary</a><a href="/DeepDive/topics">Topics</a><a href="/DeepDive/plan">Plan</a></div></div></nav>
<main><slot /></main>
<footer style="border-top:1px solid var(--border);background:var(--bg2);padding:32px 0;color:var(--faint);font:13px Inter"><div class="container" style="display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap"><div>© DeepDive, Educational demonstration only. Run only locally with AddressSanitizer.</div><div style="display:flex;gap:14px"><a href="#initial">Initial</a><a href="#defense">Defense</a></div></div></footer>
</body>
</html>
